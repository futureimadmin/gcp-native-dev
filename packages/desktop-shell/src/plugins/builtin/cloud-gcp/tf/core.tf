# Generated by Nativity Studio. Edit freely: the wizard only rewrites these files when you generate again.
terraform {
  required_version = ">= 1.6"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
  }
  # state lives in a versioned bucket in this environment's project; the bucket and prefix are passed at "terraform init"
  backend "gcs" {}
}

provider "google" {
  project = var.project_id
  region  = var.region
  # nobody runs Terraform with a key: the caller impersonates the environment's Terraform service account
  impersonate_service_account = var.impersonate_service_account
}

variable "project_id" {
  type        = string
  description = "Google Cloud project of this environment"
}

variable "region" {
  type = string
}

variable "app" {
  type        = string
  description = "Application name (prefix of every resource)"
}

variable "env" {
  type        = string
  description = "Environment name: dev, sit, uat, prod ..."
}

variable "impersonate_service_account" {
  type    = string
  default = null
}

variable "deletion_protection" {
  type        = bool
  default     = true
  description = "Protects databases and clusters from accidental deletion. Turn off only in throw-away environments."
}

variable "cidr_env" {
  type        = string
  description = "The /16 of this environment's VPC (each environment has its own, so they can be peered or connected later)"
}

variable "cidr_app" {
  type = string
}

variable "cidr_data" {
  type = string
}

variable "cidr_gke_pods" {
  type    = string
  default = ""
}

variable "cidr_gke_services" {
  type    = string
  default = ""
}

variable "cidr_gke_master" {
  type    = string
  default = ""
}

variable "psa_address" {
  type    = string
  default = ""
}

variable "psa_prefix_length" {
  type    = number
  default = 20
}

variable "enable_nat" {
  type    = bool
  default = true
}

variable "enable_psa" {
  type    = bool
  default = false
}

variable "enable_gke" {
  type    = bool
  default = false
}

variable "enable_lb_edge" {
  type    = bool
  default = false
}

locals {
  name   = "${var.app}-${var.env}"
  labels = { app = var.app, environment = var.env, managed-by = "nativity-studio" }
}

# ---------------------------------------------------------------- network
resource "google_compute_network" "vpc" {
  name                    = "${local.name}-vpc"
  auto_create_subnetworks = false
  routing_mode            = "REGIONAL"
}

resource "google_compute_subnetwork" "app" {
  name                     = "${local.name}-app"
  region                   = var.region
  network                  = google_compute_network.vpc.id
  ip_cidr_range            = var.cidr_app
  private_ip_google_access = true

  dynamic "secondary_ip_range" {
    for_each = var.enable_gke ? { pods = var.cidr_gke_pods, services = var.cidr_gke_services } : {}
    content {
      range_name    = "${local.name}-${secondary_ip_range.key}"
      ip_cidr_range = secondary_ip_range.value
    }
  }

  log_config {
    aggregation_interval = "INTERVAL_10_MIN"
    flow_sampling        = 0.5
    metadata             = "INCLUDE_ALL_METADATA"
  }
}

resource "google_compute_subnetwork" "data" {
  name                     = "${local.name}-data"
  region                   = var.region
  network                  = google_compute_network.vpc.id
  ip_cidr_range            = var.cidr_data
  private_ip_google_access = true

  log_config {
    aggregation_interval = "INTERVAL_10_MIN"
    flow_sampling        = 0.5
    metadata             = "INCLUDE_ALL_METADATA"
  }
}

resource "google_compute_router" "router" {
  count   = var.enable_nat ? 1 : 0
  name    = "${local.name}-router"
  region  = var.region
  network = google_compute_network.vpc.id
}

resource "google_compute_router_nat" "nat" {
  count                              = var.enable_nat ? 1 : 0
  name                               = "${local.name}-nat"
  router                             = google_compute_router.router[0].name
  region                             = var.region
  nat_ip_allocate_option             = "AUTO_ONLY"
  source_subnetwork_ip_ranges_to_nat = "ALL_SUBNETWORKS_ALL_IP_RANGES"

  log_config {
    enable = true
    filter = "ERRORS_ONLY"
  }
}

# private IP range for Google-managed services that live in their own network (Cloud SQL, Memorystore, Apigee)
resource "google_compute_global_address" "psa" {
  count         = var.enable_psa ? 1 : 0
  name          = "${local.name}-psa"
  purpose       = "VPC_PEERING"
  address_type  = "INTERNAL"
  address       = var.psa_address
  prefix_length = var.psa_prefix_length
  network       = google_compute_network.vpc.id
}

resource "google_service_networking_connection" "psa" {
  count                   = var.enable_psa ? 1 : 0
  network                 = google_compute_network.vpc.id
  service                 = "servicenetworking.googleapis.com"
  reserved_peering_ranges = [google_compute_global_address.psa[0].name]
}

resource "google_compute_firewall" "allow_internal" {
  name      = "${local.name}-allow-internal"
  network   = google_compute_network.vpc.id
  direction = "INGRESS"
  priority  = 1000

  source_ranges = [var.cidr_env]

  allow {
    protocol = "tcp"
  }
  allow {
    protocol = "udp"
  }
  allow {
    protocol = "icmp"
  }
}

resource "google_compute_firewall" "allow_health_checks" {
  count     = var.enable_gke || var.enable_lb_edge ? 1 : 0
  name      = "${local.name}-allow-health-checks"
  network   = google_compute_network.vpc.id
  direction = "INGRESS"
  priority  = 1000

  # Google's health-check and load-balancer ranges
  source_ranges = ["130.211.0.0/22", "35.191.0.0/16"]

  allow {
    protocol = "tcp"
  }
}

# ---------------------------------------------------------------- identity of the application
# One service account per workload with only the roles listed in the *.tf file of each service it uses.
resource "google_service_account" "app" {
  account_id   = substr("${local.name}-app", 0, 30)
  display_name = "${local.name} application"
}

resource "google_project_iam_member" "app_logging" {
  project = var.project_id
  role    = "roles/logging.logWriter"
  member  = "serviceAccount:${google_service_account.app.email}"
}

resource "google_project_iam_member" "app_metrics" {
  project = var.project_id
  role    = "roles/monitoring.metricWriter"
  member  = "serviceAccount:${google_service_account.app.email}"
}
