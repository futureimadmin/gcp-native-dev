# Generated by Nativity Studio. Edit freely: the wizard only rewrites these files when you generate again.
terraform {
  required_version = ">= 1.6"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
  }
  # state lives in a versioned bucket in this environment's project; the bucket and prefix are passed at "terraform init"
  backend "gcs" {}
}

provider "google" {
  project = var.project_id
  region  = var.region
  # nobody runs Terraform with a key: the caller impersonates the environment's Terraform service account
  impersonate_service_account = var.impersonate_service_account
}

variable "project_id" {
  type        = string
  description = "Google Cloud project of this environment"
}

variable "region" {
  type = string
}

variable "app" {
  type        = string
  description = "Application name (prefix of every resource)"
}

variable "env" {
  type        = string
  description = "Environment name: dev, sit, uat, prod ..."
}

variable "impersonate_service_account" {
  type    = string
  default = null
}

variable "deletion_protection" {
  type        = bool
  default     = true
  description = "Protects databases and clusters from accidental deletion. Turn off only in throw-away environments."
}

locals {
  name   = "${var.app}-${var.env}"
  labels = { app = var.app, environment = var.env, managed-by = "nativity-studio" }
}

# ---------------------------------------------------------------- identity of the application
# One service account per workload with only the roles listed in the *.tf file of each service it uses.
resource "google_service_account" "app" {
  account_id   = substr("${local.name}-app", 0, 30)
  display_name = "${local.name} application"
}

resource "google_project_iam_member" "app_logging" {
  project = var.project_id
  role    = "roles/logging.logWriter"
  member  = "serviceAccount:${google_service_account.app.email}"
}

resource "google_project_iam_member" "app_metrics" {
  project = var.project_id
  role    = "roles/monitoring.metricWriter"
  member  = "serviceAccount:${google_service_account.app.email}"
}
